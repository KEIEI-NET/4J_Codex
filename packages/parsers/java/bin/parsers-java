#!/usr/bin/env bash
set -euo pipefail
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_DIR="$(cd "${SCRIPT_DIR}/.." && pwd)"
JAR_PATH="${PROJECT_DIR}/target/parsers-java-0.0.1-SNAPSHOT.jar"

if [[ ! -f "${JAR_PATH}" ]]; then
  echo "[parsers-java] Build artifact not found at ${JAR_PATH}. Run 'mvn -f ${PROJECT_DIR}/pom.xml package' first." >&2
  exit 1
fi

exec java -jar "${JAR_PATH}" "$@"
